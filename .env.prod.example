# Kopieren nach .env (im selben Ordner wie docker-compose.prod.yml) und Werte anpassen.
DB_PASS=hier-ein-langes-passwort
DB_ROOT_PASS=hier-noch-ein-langes-passwort
CAMP_NAME=Bundeslager 2027

# Domain, unter der die Warenwirtschaft erreichbar sein soll. Muss per DNS
# (A-Record) schon auf die IP des Servers zeigen, bevor der Stack startet,
# sonst kann Caddy kein Let's-Encrypt-Zertifikat ausstellen.
DOMAIN=lager.deine-domain.de

# E-Mail-Adresse für Let's Encrypt (Ablauf-Erinnerungen, keine Pflicht aber sinnvoll).
ACME_EMAIL=deine-email@example.com
